generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTNER
}

enum EstStatus {
  ACTIVO
  INACTIVO
}

enum SaleStatus {
  PENDIENTE
  VALIDADA
  PAGADA
}

enum BookingStatus {
  SOLICITADA
  CONFIRMADA
  CANCELADA
}

model User {
  id                 Int            @id @default(autoincrement())
  username           String         @unique
  passwordHash       String
  role               Role
  establishment      Establishment? @relation(fields: [establishmentId], references: [id])
  establishmentId    Int?
  mustChangePassword Boolean        @default(false)
  failedAttempts     Int            @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime       @default(now())
}

model Establishment {
  id            Int       @id @default(autoincrement())
  name          String
  code          String    @unique
  contactName   String    @default("")
  email         String    @default("")
  phone         String    @default("")
  city          String    @default("")
  address       String    @default("")
  commissionPct Decimal   @default(30) @db.Decimal(5, 2)
  status        EstStatus @default(ACTIVO)
  notes         String    @default("")
  createdAt     DateTime  @default(now())
  users         User[]
  sales         Sale[]
  payouts       Payout[]
  qrCodes       QrCode[]
  bookings      Booking[]
}

model QrCode {
  code            String         @id
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  establishmentId Int?
  batch           String         @default("")
  createdAt       DateTime       @default(now())
  assignedAt      DateTime?

  @@index([establishmentId])
}

model Sale {
  id              Int           @id @default(autoincrement())
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  establishmentId Int
  saleDate        DateTime      @db.Date
  activity        String        @default("")
  bookingRef      String        @default("")
  tickets         Int           @default(1)
  amountTotal     Decimal       @default(0) @db.Decimal(10, 2)
  // Lo que ingresa NoTaxLost por esta venta. En las de GetYourGuide es la
  // comisión que paga GYG; en las actividades propias, nuestro margen. El
  // reparto al establecimiento se calcula igual en los dos casos, así que
  // liquidaciones no distingue: mira `source` para saber de dónde viene.
  gygCommission   Decimal       @default(0) @db.Decimal(10, 2)
  partnerShare    Decimal       @default(0) @db.Decimal(10, 2)
  status          SaleStatus    @default(PENDIENTE)
  payout          Payout?       @relation(fields: [payoutId], references: [id])
  payoutId        Int?
  source          String        @default("manual")
  booking         Booking?
  createdAt       DateTime      @default(now())

  @@index([establishmentId, status])
  @@index([saleDate])
}

/// Actividad que vende NoTaxLost por su cuenta (catas, visitas guiadas…). A
/// diferencia de las de GetYourGuide, la reserva se completa en notaxlost.com
/// y aterriza aquí: nosotros controlamos precio, cupo y confirmación.
model OwnActivity {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  title         String
  summary       String    @default("")
  description   String    @default("")
  province      String    @default("")
  city          String    @default("")
  category      String    @default("culture")
  imageUrl      String    @default("")
  pricePerPerson Decimal  @default(0) @db.Decimal(10, 2)
  // Porcentaje del importe que se queda NoTaxLost; el resto es del proveedor.
  ntlMarginPct  Decimal   @default(20) @db.Decimal(5, 2)
  durationMin   Int       @default(90)
  minPeople     Int       @default(1)
  capacity      Int       @default(10)
  /// Horas de inicio separadas por "|", por ejemplo "10:00|12:30|17:00".
  slots         String    @default("")
  /// Días con actividad, 0=domingo … 6=sábado, separados por comas.
  weekdays      String    @default("0,1,2,3,4,5,6")
  /// Antelación mínima para reservar y hasta cuántos días vista se abre.
  leadHours     Int       @default(24)
  horizonDays   Int       @default(60)
  meetingPoint  String    @default("")
  supplierName  String    @default("")
  supplierEmail String    @default("")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  bookings      Booking[]

  @@index([active])
}

model Booking {
  id              Int            @id @default(autoincrement())
  reference       String         @unique
  activity        OwnActivity    @relation(fields: [activityId], references: [id])
  activityId      Int
  /// Establecimiento del QR por el que llegó el cliente, si venía con `ref`.
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  establishmentId Int?
  refCode         String         @default("")
  bookingDate     DateTime       @db.Date
  slot            String         @default("")
  people          Int            @default(1)
  amountTotal     Decimal        @default(0) @db.Decimal(10, 2)
  customerName    String
  customerEmail   String
  customerPhone   String         @default("")
  notes           String         @default("")
  locale          String         @default("es")
  status          BookingStatus  @default(SOLICITADA)
  /// Venta generada al confirmar, para que entre en las liquidaciones.
  sale            Sale?          @relation(fields: [saleId], references: [id])
  saleId          Int?           @unique
  createdAt       DateTime       @default(now())

  @@index([activityId, bookingDate])
  @@index([status])
  @@index([establishmentId])
}

model Payout {
  id              Int           @id @default(autoincrement())
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  establishmentId Int
  amount          Decimal       @db.Decimal(10, 2)
  nSales          Int
  paymentDate     DateTime      @db.Date
  method          String        @default("transferencia")
  reference       String        @default("")
  notes           String        @default("")
  createdAt       DateTime      @default(now())
  sales           Sale[]
}

model Setting {
  key   String @id
  value String
}
