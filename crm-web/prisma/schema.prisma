generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTNER
}

enum EstStatus {
  ACTIVO
  INACTIVO
}

enum SaleStatus {
  PENDIENTE
  VALIDADA
  PAGADA
}

enum BookingStatus {
  SOLICITADA
  CONFIRMADA
  CANCELADA
}

/// Se clasifica por DONDE VA EL DINERO, no por quien escribe el papel.
///
/// Parece un matiz y no lo es: GetYourGuide nos manda a nosotros la factura de
/// lo que nos paga (autofactura), y nosotros le mandamos al establecimiento la
/// de lo que le pagamos. Si se clasificara por quien la expide, las dos
/// acabarian en el libro contrario al que les toca.
enum InvoiceKind {
  /// Dinero que entra. La de GetYourGuide: va al libro de facturas expedidas.
  INGRESO
  /// Dinero que sale. La del establecimiento: va al libro de recibidas.
  GASTO
}

model User {
  id                 Int            @id @default(autoincrement())
  username           String         @unique
  passwordHash       String
  role               Role
  establishment      Establishment? @relation(fields: [establishmentId], references: [id])
  establishmentId    Int?
  mustChangePassword Boolean        @default(false)
  failedAttempts     Int            @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime       @default(now())
}

model Establishment {
  id            Int       @id @default(autoincrement())
  name          String
  code          String    @unique
  contactName   String    @default("")
  email         String    @default("")
  phone         String    @default("")
  city          String    @default("")
  address       String    @default("")
  commissionPct Decimal   @default(30) @db.Decimal(5, 2)
  status        EstStatus @default(ACTIVO)
  notes         String    @default("")
  createdAt     DateTime  @default(now())
  users         User[]
  sales         Sale[]
  payouts       Payout[]
  qrCodes       QrCode[]
  bookings      Booking[]
  invoices      Invoice[]
}

model QrCode {
  code            String         @id
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  establishmentId Int?
  batch           String         @default("")
  createdAt       DateTime       @default(now())
  assignedAt      DateTime?

  @@index([establishmentId])
}

model Sale {
  id              Int            @id @default(autoincrement())
  /// Sin establecimiento = venta directa: entró por notaxlost.com sin QR, así
  /// que es nuestra entera y no se liquida a nadie. Se registra igual porque
  /// también es ingreso, y sin ella la contabilidad no cuadra.
  ///
  /// `Restrict` a propósito: que el campo admita nulos no puede convertirse en
  /// que borrar un establecimiento pase sus ventas a directas. Eso borraría en
  /// silencio lo que le debemos.
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  establishmentId Int?
  saleDate        DateTime       @db.Date
  activity        String         @default("")
  bookingRef      String         @default("")
  tickets         Int            @default(1)
  amountTotal     Decimal        @default(0) @db.Decimal(10, 2)
  // Lo que ingresa NoTaxLost por esta venta. En las de GetYourGuide es la
  // comisión que paga GYG; en las actividades propias, nuestro margen. El
  // reparto al establecimiento se calcula igual en los dos casos, así que
  // liquidaciones no distingue: mira `source` para saber de dónde viene.
  gygCommission   Decimal        @default(0) @db.Decimal(10, 2)
  partnerShare    Decimal        @default(0) @db.Decimal(10, 2)
  status          SaleStatus     @default(PENDIENTE)
  payout          Payout?        @relation(fields: [payoutId], references: [id])
  payoutId        Int?
  source          String         @default("manual")
  booking         Booking?
  createdAt       DateTime       @default(now())
  invoices        Invoice[]

  @@index([establishmentId, status])
  @@index([saleDate])
}

/// Actividad que vende NoTaxLost por su cuenta (catas, visitas guiadas…). A
/// diferencia de las de GetYourGuide, la reserva se completa en notaxlost.com
/// y aterriza aquí: nosotros controlamos precio, cupo y confirmación.
model OwnActivity {
  id             Int       @id @default(autoincrement())
  slug           String    @unique
  title          String
  summary        String    @default("")
  description    String    @default("")
  province       String    @default("")
  city           String    @default("")
  category       String    @default("culture")
  imageUrl       String    @default("")
  pricePerPerson Decimal   @default(0) @db.Decimal(10, 2)
  // Porcentaje del importe que se queda NoTaxLost; el resto es del proveedor.
  ntlMarginPct   Decimal   @default(20) @db.Decimal(5, 2)
  durationMin    Int       @default(90)
  minPeople      Int       @default(1)
  capacity       Int       @default(10)
  /// Horas de inicio separadas por "|", por ejemplo "10:00|12:30|17:00".
  slots          String    @default("")
  /// Días con actividad, 0=domingo … 6=sábado, separados por comas.
  weekdays       String    @default("0,1,2,3,4,5,6")
  /// Antelación mínima para reservar y hasta cuántos días vista se abre.
  leadHours      Int       @default(24)
  horizonDays    Int       @default(60)
  meetingPoint   String    @default("")
  supplierName   String    @default("")
  supplierEmail  String    @default("")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  bookings       Booking[]

  @@index([active])
}

model Booking {
  id              Int            @id @default(autoincrement())
  reference       String         @unique
  /// Localizador comun cuando el cliente reserva un plan entero de una vez.
  /// Vacio si reservo una sola actividad. Todas las del grupo se crean o
  /// fallan juntas: nadie se queda con la cata y sin la visita.
  groupRef        String         @default("")
  /// Posicion dentro del plan, para enseñarlo en el orden en que se hace.
  groupOrder      Int            @default(0)
  activity        OwnActivity    @relation(fields: [activityId], references: [id])
  activityId      Int
  /// Establecimiento del QR por el que llegó el cliente, si venía con `ref`.
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  establishmentId Int?
  refCode         String         @default("")
  bookingDate     DateTime       @db.Date
  slot            String         @default("")
  people          Int            @default(1)
  amountTotal     Decimal        @default(0) @db.Decimal(10, 2)
  customerName    String
  customerEmail   String
  customerPhone   String         @default("")
  notes           String         @default("")
  locale          String         @default("es")
  status          BookingStatus  @default(SOLICITADA)
  /// Venta generada al confirmar, para que entre en las liquidaciones.
  sale            Sale?          @relation(fields: [saleId], references: [id])
  saleId          Int?           @unique
  createdAt       DateTime       @default(now())

  @@index([activityId, bookingDate])
  @@index([status])
  @@index([establishmentId])
  @@index([groupRef])
}

model Payout {
  id              Int           @id @default(autoincrement())
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  establishmentId Int
  amount          Decimal       @db.Decimal(10, 2)
  nSales          Int
  paymentDate     DateTime      @db.Date
  method          String        @default("transferencia")
  reference       String        @default("")
  notes           String        @default("")
  createdAt       DateTime      @default(now())
  sales           Sale[]
  invoices        Invoice[]
}

/// Una factura archivada, con su PDF.
///
/// El fichero NO vive en la base de datos: se guarda en disco (`FACTURAS_DIR`)
/// y aquí queda su ficha. Meter PDFs en Postgres hincha las copias de
/// seguridad hasta que dejan de hacerse, y estos papeles hay que conservarlos
/// años.
/// Una factura archivada, con su PDF.
///
/// No se teclea NADA de su contenido. Todo lo que hay que saber de ella ya
/// esta en el CRM: el importe de una factura de GetYourGuide es la comision
/// que ya importamos de su propio export, y el de una que emitimos nosotros es
/// la liquidacion que calculamos nosotros. Los campos de abajo se rellenan
/// solos desde la venta o la liquidacion con la que se enlaza.
///
/// El fichero NO vive en la base de datos: se guarda en disco (`FACTURAS_DIR`)
/// y aqui queda su ficha. Meter PDFs en Postgres hincha las copias de
/// seguridad hasta que dejan de hacerse, y estos papeles hay que conservarlos
/// anos.
model Invoice {
  id           Int         @id @default(autoincrement())
  kind         InvoiceKind
  /// Numero del documento. En las de gasto lo ponemos nosotros (serie propia).
  number       String      @default("")
  issueDate    DateTime    @db.Date
  /// La otra parte. Sale del enlace, no se escribe.
  counterparty String      @default("")
  concept      String      @default("")
  /// Importe. Sale de la venta o de la liquidacion enlazada.
  total        Decimal     @default(0) @db.Decimal(10, 2)

  /// Nombre con el que la subio el usuario; solo para ensenarlo y descargarla.
  fileName   String
  fileMime   String @default("application/pdf")
  fileSize   Int    @default(0)
  /// Nombre en disco, generado por nosotros. Nunca sale del nombre original:
  /// un fichero llamado `../../etc/passwd` no puede acabar siendo una ruta.
  storedName String @unique
  /// Huella del contenido, para no archivar dos veces el mismo papel.
  sha256     String @default("")

  /// A que se refiere. De aqui salen los datos de arriba.
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  establishmentId Int?
  sale            Sale?          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleId          Int?
  payout          Payout?        @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  payoutId        Int?

  notes     String   @default("")
  createdAt DateTime @default(now())

  @@index([kind, issueDate])
  @@index([establishmentId])
  @@index([sha256])
  @@index([saleId])
}

model Setting {
  key   String @id
  value String
}
