# Copia este archivo a .env y rellena los valores.
# Genera los secretos con:  openssl rand -base64 36

# Contraseña de la base de datos Postgres (interna al servidor)
POSTGRES_USER=crm
POSTGRES_PASSWORD=CAMBIAR_por_una_contraseña_larga
POSTGRES_DB=crm

# Secreto para firmar las sesiones. OBLIGATORIO y mínimo 32 caracteres:
# la app se niega a arrancar si es más corto. Genera uno con: openssl rand -base64 48
AUTH_SECRET=CAMBIAR_por_un_secreto_largo_aleatorio

# Contraseña inicial del usuario "admin" (mínimo 8 caracteres).
# Si la dejas vacía, la app genera una aleatoria y la imprime en los logs del
# contenedor la primera vez (docker compose logs app). En ambos casos se te
# pedirá cambiarla al primer inicio de sesión.
INITIAL_ADMIN_PASSWORD=

# Puerto local donde escucha la app (el proxy inverso apunta aquí).
# Solo accesible desde el propio servidor (127.0.0.1).
APP_PORT=8090

# Orígenes extra desde los que se aceptan reservas de actividades propias,
# separados por comas. NO hace falta tocarlo: el de la web sale solo de la URL
# base de los QR (Ajustes → URL de la web). Esto es para pruebas o para un
# segundo dominio, p. ej.: https://staging.notaxlost.com
PUBLIC_WEB_ORIGINS=

# Días que se conservan las copias de seguridad
BACKUP_RETENTION_DAYS=14
