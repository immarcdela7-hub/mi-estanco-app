# Copia este archivo a .env y rellena los valores.
# Genera los secretos con:  openssl rand -base64 36

# Contraseña de la base de datos Postgres (interna al servidor)
POSTGRES_USER=crm
POSTGRES_PASSWORD=CAMBIAR_por_una_contraseña_larga
POSTGRES_DB=crm

# Secreto para firmar las sesiones (mínimo 32 caracteres aleatorios)
AUTH_SECRET=CAMBIAR_por_un_secreto_largo_aleatorio

# Puerto local donde escucha la app (el proxy inverso apunta aquí).
# Solo accesible desde el propio servidor (127.0.0.1).
APP_PORT=8090

# Días que se conservan las copias de seguridad
BACKUP_RETENTION_DAYS=14
